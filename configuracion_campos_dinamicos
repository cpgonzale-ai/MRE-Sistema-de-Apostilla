<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SIA-PY | Configuración de Campos Maestros</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        :root {
            --mre-blue: #002855;
            --mre-blue-light: #0038A8;
            --mre-red: #D52B1E;
            --mre-green: #10B981;
            --soft-bg: #f0f4f8; 
            --border-color: #E2E8F0;
            --input-bg: #F8FAFC;
            --text-main: #1E293B;
            --text-muted: #64748B;
            --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 10px 15px -3px rgba(0, 40, 85, 0.05);
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            --font-scale: 1; 
            --base-font-size: 16px;
        }

        html { font-size: calc(var(--base-font-size) * var(--font-scale)); }

        /* --- MODOS DE ACCESIBILIDAD --- */
        body.high-contrast {
            --mre-blue: #000000;
            --mre-blue-light: #000000;
            --mre-red: #D50000;
            --soft-bg: #FFFFFF;
            --border-color: #000000;
            --input-bg: #FFFFFF;
            --text-main: #000000;
            --text-muted: #000000;
            --card-shadow: none;
        }
        body.grayscale-mode { filter: grayscale(100%); }

        body { 
            font-family: 'Inter', sans-serif; 
            margin: 0; background-color: var(--soft-bg); color: var(--text-main); 
            overflow: hidden; display: flex; flex-direction: column; height: 100vh;
        }

        .elegant-background { 
            position: fixed; inset: 0; z-index: -1; background-color: #f8fafc; 
            background-image: 
                radial-gradient(at 0% 0%, rgba(0, 56, 168, 0.08) 0px, transparent 50%), 
                radial-gradient(at 100% 0%, rgba(213, 43, 30, 0.05) 0px, transparent 50%);
        }

        /* --- CABECERA --- */
        .portal-header { 
            display: flex; justify-content: space-between; align-items: center; background: white; 
            padding: 0.75rem 1.5rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); 
            border-bottom: 1px solid var(--border-color); position: relative; z-index: 2000;
        }

        .mobile-toggle-btn {
            background: transparent; border: none; color: var(--mre-blue); cursor: pointer;
            padding: 8px; display: none; border-radius: 8px; transition: var(--transition);
        }
        .mobile-toggle-btn:hover { background: #F1F5F9; }

        /* ACCESIBILIDAD */
        .a11y-container { position: relative; margin-right: 15px; }
        .btn-a11y-trigger {
            background: #F8FAFC; border: 1px solid var(--border-color); color: var(--mre-blue);
            border-radius: 12px; padding: 0.5rem 1rem; font-weight: 700; font-size: 0.75rem;
            display: flex; align-items: center; gap: 6px; transition: var(--transition);
        }
        .a11y-dropdown-menu {
            position: absolute; top: calc(100% + 10px); right: 0; 
            background: white; border-radius: 16px; width: 280px;
            box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.15); border: 1px solid var(--border-color);
            display: none; z-index: 3000; padding: 1rem;
        }
        .a11y-dropdown-menu.show { display: block; animation: fadeIn 0.2s ease-out; }
        .text-resize-controls {
            display: flex; justify-content: space-between; align-items: center;
            background: #F8FAFC; border-radius: 10px; padding: 4px; border: 1px solid #E2E8F0;
        }
        .btn-resize {
            width: 32px; height: 32px; border: none; background: white; border-radius: 8px;
            color: var(--mre-blue); display: flex; align-items: center; justify-content: center;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        }
        .a11y-section-title { font-size: 0.7rem; font-weight: 800; text-transform: uppercase; color: #94A3B8; margin-bottom: 0.8rem; letter-spacing: 0.5px; }
        .font-size-display { font-size: 0.85rem; font-weight: 700; color: #475569; }
        .switch-control { display: flex; justify-content: space-between; align-items: center; padding: 0.6rem 0; border-bottom: 1px solid #F1F5F9; }
        .switch-label { font-size: 0.85rem; font-weight: 600; color: var(--text-main); display: flex; align-items: center; gap: 8px; }
        .toggle-switch { position: relative; display: inline-block; width: 40px; height: 22px; }
        .toggle-switch input { opacity: 0; width: 0; height: 0; }
        .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #cbd5e1; transition: .4s; border-radius: 34px; }
        .slider:before { position: absolute; content: ""; height: 16px; width: 16px; left: 3px; bottom: 3px; background-color: white; transition: .4s; border-radius: 50%; }
        input:checked + .slider { background-color: var(--mre-blue); }
        input:checked + .slider:before { transform: translateX(18px); }

        /* PERFIL */
        .dots-menu-trigger {
            width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;
            border-radius: 10px; cursor: pointer; transition: var(--transition); color: var(--text-muted);
            background: #F8FAFC; border: 1px solid var(--border-color);
        }
        .dots-menu-trigger:hover { background: #F1F5F9; color: var(--mre-blue-light); border-color: var(--mre-blue-light); }
        .dropdown-menu-mre { 
            position: absolute; top: calc(100% + 10px); right: 0; background: white; border-radius: 12px; 
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1); border: 1px solid var(--border-color); 
            width: 180px; display: none; z-index: 3000; overflow: hidden; animation: fadeIn 0.2s ease-out;
        }
        .dropdown-menu-mre.show { display: block; }
        .dropdown-header-info { padding: 16px; background: #F8FAFC; border-bottom: 1px solid var(--border-color); }
        .dropdown-item-mre {
            padding: 12px 16px; border: none; background: none; width: 100%; text-align: left;
            font-size: 0.9rem; font-weight: 600; color: #475569; display: flex; align-items: center; gap: 10px;
        }
        .dropdown-item-mre:hover { background: #F8FAFC; color: var(--mre-red); }

        /* --- LAYOUT PRINCIPAL --- */
        .app-container { display: flex; flex: 1; overflow: hidden; position: relative; flex-direction: row; }

        /* --- SIDEBAR PRINCIPAL --- */
        .main-sidebar {
            width: 280px; background: white; border-right: 1px solid var(--border-color);
            display: flex; flex-direction: column; z-index: 1000;
            box-shadow: 4px 0 10px rgba(0,0,0,0.02);
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            overflow-x: hidden;
        }

        .sidebar-overlay {
            position: fixed; inset: 0; background: rgba(0, 40, 85, 0.5); 
            z-index: 900; display: none; backdrop-filter: blur(2px);
            opacity: 0; transition: opacity 0.3s ease;
        }
        .sidebar-overlay.active { display: block; opacity: 1; }

        .nav-menu { padding: 1.5rem 1rem; flex: 1; }
        .nav-link-mre {
            display: flex; align-items: center; gap: 12px; padding: 0.85rem 1rem;
            color: var(--text-muted); text-decoration: none; border-radius: 12px;
            font-size: 0.9rem; font-weight: 600; margin-bottom: 4px; transition: var(--transition);
            white-space: nowrap;
        }
        .nav-link-mre:hover { background: #F1F5F9; color: var(--mre-blue); }
        .nav-link-mre.active { background: #f0f7ff; color: var(--mre-blue-light); box-shadow: 0 4px 6px -1px rgba(0, 40, 85, 0.05); }

        /* --- ÁREA DE CONTENIDO (DERECHA) --- */
        .content-area { flex: 1; padding: 2rem 3rem; overflow-y: auto; position: relative; }
        
        /* GRILLA */
        .grid-frame { 
            background: white; border-radius: 20px; box-shadow: var(--card-shadow); 
            border: 1px solid #E2E8F0; position: relative; overflow: hidden;
            display: flex; flex-direction: column; margin-bottom: 2rem;
        }
        .grid-frame::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 4px; background: linear-gradient(to right, var(--mre-red), var(--mre-blue)); }
        .grid-header-frame { background-color: #F1F5F9; padding: 1rem 1.5rem; border-bottom: 1px solid #E2E8F0; display: flex; justify-content: space-between; align-items: center; }

        .mre-table { width: 100%; border-collapse: separate; border-spacing: 0; }
        .mre-table th { font-size: 0.75rem; font-weight: 800; color: #64748B; text-transform: uppercase; padding: 1rem 1.5rem; border-bottom: 2px solid #E2E8F0; background: #fafbfc; }
        .mre-table td { padding: 1rem 1.5rem; font-size: 0.8rem; border-bottom: 1px solid #F1F5F9; vertical-align: middle; }

        /* BOTONES HERRAMIENTAS */
        .btn-tool-generic {
            background: #FFFFFF; color: var(--mre-blue); border: 1px solid var(--border-color);
            padding: 0.5rem 1rem; border-radius: 10px; font-size: 0.75rem; font-weight: 700;
            display: flex; align-items: center; gap: 8px; transition: var(--transition);
            cursor: pointer; margin-right: 8px;
        }
        .btn-tool-generic:hover { background: #F1F5F9; border-color: var(--mre-blue); }

        /* PAGINACIÓN */
        .grid-footer {
            padding: 1rem 1.5rem; background-color: #F8FAFC; border-top: 1px solid var(--border-color);
            display: flex; justify-content: space-between; align-items: center;
        }
        .btn-pagination {
            width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;
            background: white; border: 1px solid #E2E8F0; border-radius: 8px;
            color: #64748B; cursor: pointer; transition: var(--transition);
        }
        .btn-pagination:hover:not(:disabled) { background: var(--mre-blue); color: white; border-color: var(--mre-blue); }
        .btn-pagination:disabled { opacity: 0.5; cursor: not-allowed; background: #F1F5F9; }
        .page-indicator { font-size: 0.85rem; font-weight: 700; color: var(--mre-blue); padding: 0 8px; }

        .btn-main { background: linear-gradient(135deg, var(--mre-blue) 0%, var(--mre-blue-light) 100%); color: #ffffff; border: none; border-radius: 12px; padding: 0.6rem 1.2rem; font-weight: 700; font-size: 0.85rem; }

        .mre-modal-overlay { position: fixed; inset: 0; background: rgba(0, 40, 85, 0.4); backdrop-filter: blur(4px); z-index: 4000; display: none; align-items: center; justify-content: center; padding: 20px; }
        .mre-modal { background: white; border-radius: 24px; max-width: 950px; width: 100%; padding: 2.5rem; position: relative; box-shadow: 0 25px 50px rgba(0,0,0,0.2); max-height: 95vh; overflow-y: auto; }
        
        .section-title { font-size: 0.95rem; font-weight: 900; color: var(--mre-blue); text-transform: uppercase; display: flex; align-items: center; gap: 10px; margin-bottom: 1.5rem; }
        .section-title::after { content: ''; flex: 1; height: 1px; background: #E2E8F0; }

        .form-label { font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.5rem; display: block; }
        .form-control-mre { background-color: var(--input-bg); border: 1px solid #E2E8F0; border-radius: 10px; padding: 0.75rem 1rem; font-size: 0.9rem; width: 100%; transition: var(--transition); }

        .values-images-card { background-color: #F1F5F9; border-radius: 16px; padding: 1.5rem; margin-top: 1rem; border: 1px solid var(--border-color); }
        .value-image-row { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem; background: white; padding: 0.5rem 1rem; border-radius: 10px; border: 1px solid #E2E8F0; }
        .value-name-label { min-width: 120px; font-weight: 700; font-size: 0.85rem; color: var(--text-main); }

        .audit-grid-table { width: 100%; border-collapse: separate; border-spacing: 0; border: 1px solid var(--border-color); border-radius: 12px; overflow: hidden; }
        .audit-grid-table th { background: #F8FAFC; color: #64748B; font-size: 0.65rem; font-weight: 800; padding: 0.75rem 1rem; border-bottom: 1px solid #border-color; }
        .audit-grid-table td { padding: 0.75rem 1rem; border-bottom: 1px solid #F1F5F9; font-size: 0.8rem; }
        
        .badge-audit { padding: 3px 8px; border-radius: 5px; font-size: 0.65rem; font-weight: 800; }
        .tag-create { background: #DCFCE7; color: #15803D; }
        .tag-update { background: #E0F2FE; color: #0369A1; }

        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .animate-fade { animation: fadeIn 0.4s ease-out forwards; }
        
        .mre-sidebar-popup {
            position: fixed; background: #1e293b; color: #f1f5f9; padding: 12px 16px;
            border-radius: 12px; font-size: 0.75rem; font-weight: 600;
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3); z-index: 6000;
            display: none; opacity: 0; transition: opacity 0.2s ease-out; max-width: 240px;
        }
        .mre-sidebar-popup.show { display: block; opacity: 1; }
        .mre-sidebar-popup a { color: #38bdf8; text-decoration: underline; display: block; margin-top: 6px; font-weight: 800; }

        /* Mensaje de advertencia para imágenes */
        .warning-images {
            background: #FFFBEB;
            border: 1px solid #FDE68A;
            color: #92400E;
            padding: 1rem;
            border-radius: 12px;
            font-size: 0.85rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
            animation: fadeIn 0.3s ease-out;
        }
    </style>
</head>
<body>

    <div class="elegant-background"></div>
    <div id="sidebarGlobalPopup" class="mre-sidebar-popup"></div>
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

    <header class="portal-header animate-fade">
        <div class="d-flex align-items-center gap-3">
            <button class="mobile-toggle-btn" onclick="toggleSidebar()" aria-label="Abrir menú de navegación">
                <i data-lucide="menu" style="width: 26px;"></i>
            </button>
            <div class="bg-white p-2 rounded-3 border d-none d-sm-block" style="box-shadow: 0 4px 6px rgba(0,0,0,0.05)" title="Inicio SIA-PY">
                <i data-lucide="globe" style="color: var(--mre-blue); width: 22px;"></i>
            </div>
            <div>
                <h6 class="fw-black mb-0" style="color: var(--mre-blue); font-size: 1.1rem;">SIA-PY</h6>
                <p class="text-muted small mb-0 fw-bold uppercase" style="font-size: 0.65rem; letter-spacing: 1px;">Gestión Administrativa</p>
            </div>
        </div>
        
        <div class="user-dropdown d-flex align-items-center gap-3">
            <!-- ACCESIBILIDAD -->
            <div class="a11y-container d-inline-block">
                <button class="btn-a11y-trigger" id="a11yTrigger" onclick="toggleA11yMenu(event)" title="Opciones de Accesibilidad">
                    <i data-lucide="accessibility" style="width: 18px;"></i>
                    <span class="d-none d-md-inline">Accesibilidad</span>
                    <i data-lucide="chevron-down" class="lucide-chevron-down" style="width: 14px; margin-left: 4px;"></i>
                </button>
                <div class="a11y-dropdown-menu" id="a11yMenu" onclick="event.stopPropagation()">
                    <div class="a11y-section-title">Tamaño de Texto</div>
                    <div class="text-resize-controls">
                        <button class="btn-resize" onclick="changeFontSize(-0.1)" title="Reducir"><i data-lucide="minus" style="width: 16px;"></i></button>
                        <span class="font-size-display" id="fontSizeDisplay">100%</span>
                        <button class="btn-resize" onclick="changeFontSize(0.1)" title="Aumentar"><i data-lucide="plus" style="width: 16px;"></i></button>
                    </div>

                    <div class="a11y-section-title mt-3">Visualización</div>
                    <div class="switch-control">
                        <div class="switch-label"><i data-lucide="eye-off" style="width: 16px;"></i> Escala de Grises</div>
                        <label class="toggle-switch">
                            <input type="checkbox" id="switchGrayscale" onchange="toggleGrayscale()">
                            <span class="slider"></span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="user-info-text">
                <div class="user-name">Carlos González</div>
                <div class="user-id">CI: 4.567.890</div>
            </div>
            <div class="dots-menu-trigger" id="profileTrigger" onclick="toggleUserMenu(event)" title="Menú de usuario" aria-label="Menú de usuario" tabindex="0">
                <i data-lucide="user" style="width: 20px;"></i>
            </div>
            <div class="dropdown-menu-mre" id="userMenu">
                <div class="dropdown-header-info">
                    <p class="fw-black text-navy mb-0" style="font-size: 0.85rem;">Carlos González</p>
                    <p class="text-muted small mb-0 fw-bold">CI: 4.567.890</p>
                </div>
                <button class="dropdown-item-mre text-danger" onclick="handleLogout()" title="Cerrar sesión actual">
                    <i data-lucide="log-out" style="width: 14px;"></i> Cerrar Sesión
                </button>
            </div>
        </div>
    </header>

    <div class="app-container">
        <aside class="main-sidebar animate-fade" id="mainSidebar">
            <nav class="nav-menu">
                <div class="d-flex justify-content-between align-items-center mb-3 px-3 d-lg-none">
                    <span class="text-muted fw-bold uppercase" style="font-size: 0.8rem;">Menú</span>
                    <button class="btn btn-sm btn-light" onclick="toggleSidebar()" aria-label="Cerrar menú">
                        <i data-lucide="x" style="width: 16px;"></i>
                    </button>
                </div>

                <p class="px-3 mb-2 text-muted fw-bold uppercase" style="font-size: 0.7rem; letter-spacing: 1.2px;">Administración</p>
                <a href="#" class="nav-link-mre" title="Tipos de documentos" data-popup="Prototipo pendiente de construcción"><i data-lucide="file-text" style="width: 18px;"></i> <span>Tipos de documentos</span></a>
                <a href="#" class="nav-link-mre" title="Usuarios" data-popup="Prototipo pendiente de construcción"><i data-lucide="users" style="width: 18px;"></i> <span>Usuarios</span></a>
                <a href="#" class="nav-link-mre" title="Grupos y Permisos" data-popup="Módulo bajo seguridad restringida"><i data-lucide="shield-check" style="width: 18px;"></i> <span>Grupos y Permisos</span></a>
                <a href="#" class="nav-link-mre" title="Configuración de referencias" data-popup="Prototipo terminado. <a href='#'>[SIA-PY | Configuración de Referencias]</a>"><i data-lucide="settings-2" style="width: 18px;"></i> <span>Configuración de referencias</span></a>
                <a href="#" class="nav-link-mre active" title="Configuración de campos"><i data-lucide="layout-grid" style="width: 18px;"></i> <span>Configuración de campos</span></a>
            </nav>
        </aside>

        <main class="content-area">
            <header class="d-flex justify-content-between align-items-end mb-4 animate-fade">
                <div>
                    <h2 class="fw-black text-navy m-0">Campos Maestros</h2>
                    <p class="text-muted small mb-0">Gestione los elementos dinámicos para los formularios del portal</p>
                </div>
                <button class="btn-main shadow-sm" onclick="openFieldModal('add')" title="Registrar un nuevo campo maestro">
                    <i data-lucide="plus" style="width: 16px;" class="me-2"></i> Nuevo Campo Maestro
                </button>
            </header>

            <div class="grid-frame animate-fade">
                <div class="grid-header-frame">
                    <h4 class="fw-black text-uppercase m-0" style="color: var(--mre-blue); font-size: 0.85rem;">Listado de Campos</h4>
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn-tool-generic" onclick="alert('Configurar Columnas')" title="Configurar visibilidad de las columnas">
                            <i data-lucide="layout-columns" style="width: 16px;"></i> Columnas
                        </button>
                        <button class="btn-tool-generic" onclick="alert('Exportando a Excel...')" title="Descargar listado en Excel">
                            <i data-lucide="file-spreadsheet" style="width: 16px;"></i> Excel
                        </button>
                        <button class="btn-tool-generic" onclick="alert('Exportando a PDF...')" title="Generar reporte PDF">
                            <i data-lucide="file-text" style="width: 16px;"></i> PDF
                        </button>
                        
                        <div class="position-relative" style="max-width: 250px;">
                            <i data-lucide="search" class="position-absolute" style="left:12px; top:50%; transform:translateY(-50%); color:#94A3B8; width:16px;"></i>
                            <input type="text" id="masterFieldSearch" class="form-control-mre ps-5" placeholder="Filtrar..." onkeyup="handleMasterFieldSearch()" title="Búsqueda rápida">
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="mre-table">
                        <thead>
                            <tr>
                                <th width="40" class="text-center">
                                    <input type="checkbox" id="selectAllFields" onchange="updateSelectionUI()" title="Seleccionar todos">
                                </th>
                                <th width="80" class="text-center">ID</th>
                                <th>Etiqueta</th>
                                <th>Nombre Técnico</th>
                                <th>Tipo</th>
                                <th width="120" class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="masterFieldsTableBody"></tbody>
                    </table>
                </div>

                <div class="grid-footer">
                    <div>
                        <span class="text-muted small fw-bold" id="paginationInfo">Mostrando 1 a 3 de 3 registros</span>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-danger border-0 fw-bold d-flex align-items-center gap-2" id="btnInactivateFields" disabled onclick="confirmInactivateItems()" title="Inactivar registros seleccionados">
                            <i data-lucide="power" style="width: 14px;"></i> Inactivar
                        </button>
                        <button class="btn btn-outline-secondary border-0 fw-bold d-flex align-items-center gap-2" onclick="handleCancelSelection()" title="Limpiar selección">
                            <i data-lucide="x" style="width: 14px;"></i> Cancelar
                        </button>
                    </div>

                    <div class="d-flex align-items-center gap-1">
                        <button class="btn-pagination" title="Primera"><i data-lucide="chevrons-left" style="width: 16px;"></i></button>
                        <button class="btn-pagination" title="Anterior"><i data-lucide="chevron-left" style="width: 16px;"></i></button>
                        <span class="page-indicator" title="Indicador de página">Pág 1 de 1</span>
                        <button class="btn-pagination" title="Siguiente"><i data-lucide="chevron-right" style="width: 16px;"></i></button>
                        <button class="btn-pagination" title="Última"><i data-lucide="chevrons-right" style="width: 16px;"></i></button>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- MODAL CAMPO MAESTRO -->
    <div class="mre-modal-overlay" id="modalFieldMaster">
        <div class="mre-modal animate-fade">
            <div class="section-title" id="masterFieldModalTitle">Configuración de Campo Maestro</div>
            <form id="formMasterField">
                <div class="row g-4 mb-4">
                    <div class="col-md-4">
                        <label class="form-label">Etiqueta <span class="text-danger">*</span></label>
                        <input type="text" id="fieldLabel" class="form-control-mre" placeholder="ej: Fecha de Emisión" required title="Nombre visual del campo">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Nombre Técnico <span class="text-danger">*</span></label>
                        <input type="text" id="fieldName" class="form-control-mre" placeholder="ej: fec_emision" required title="Atributo técnico (BD)">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Tipo de Componente <span class="text-danger">*</span></label>
                        <select id="fieldType" class="form-control-mre" onchange="toggleOptionsField()" required title="Seleccione el componente de entrada">
                            <option value="">Seleccione...</option>
                            <option value="TEXT">Texto</option>
                            <option value="DATE">Fecha</option>
                            <option value="NUMBER">Numérico</option>
                            <option value="FIXED_LIST">Lista fija</option>
                            <option value="SELECT">Selección (Dropdown)</option>
                        </select>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-4">
                        <label class="form-label">Orden Base</label>
                        <input type="number" id="fieldBaseOrder" class="form-control-mre" value="1" min="1" title="Posición de aparición">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Longitud Máxima</label>
                        <input type="number" id="fieldMaxLength" class="form-control-mre" placeholder="ej: 255" title="Caracteres permitidos">
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="d-flex align-items-center gap-3 p-2 rounded-3 bg-light border w-100" style="height: 44px;" title="Si es obligatorio por defecto">
                            <input type="checkbox" id="fieldRequiredBase" class="ms-2">
                            <span class="fw-bold text-muted uppercase" style="font-size: 0.7rem;">¿Requerido por Base?</span>
                        </div>
                    </div>
                </div>

                <div class="row g-4 mb-4 d-none" id="containerPossibleValues">
                    <div class="col-md-12">
                        <label class="form-label">Valores Posibles (separados por coma)</label>
                        <div class="d-flex align-items-center gap-2">
                            <input type="text" id="fieldPossibleValues" class="form-control-mre" placeholder="ej: Opción 1, Opción 2" oninput="renderValueImageInputs()" title="Opciones de la lista">
                            <div class="d-flex align-items-center gap-2 p-2 rounded-3 bg-light border whitespace-nowrap" style="height: 44px;">
                                <input type="checkbox" id="checkUseValueImages" onchange="toggleValueImagesSection()">
                                <span class="fw-bold text-muted uppercase" style="font-size: 0.6rem;">¿Imágenes?</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 d-none" id="containerValuesImages">
                        <!-- Aquí se renderizan o el mensaje o la lista de imágenes -->
                        <div id="valueImagesList"></div>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label class="form-label">Ruta Imagen Referencial</label>
                        <input type="text" id="fieldImagePath" class="form-control-mre" placeholder="/assets/img/ayuda.png" title="Icono de ayuda">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Texto de Ayuda (Placeholder)</label>
                        <input type="text" id="fieldPlaceholder" class="form-control-mre" placeholder="ej: Escriba aquí..." title="Guía interna del campo">
                    </div>
                </div>

                <div class="row g-4 mb-4 d-none" id="containerSQL">
                    <div class="col-12">
                        <label class="form-label">Sentencia SQL de Origen</label>
                        <textarea id="fieldDesc" class="form-control-mre" rows="2" style="font-family: monospace;"></textarea>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-12">
                        <label class="form-label">Descripción Administrativa</label>
                        <textarea id="fieldGeneralDesc" class="form-control-mre" rows="2" placeholder="Notas internas..."></textarea>
                    </div>
                </div>

                <div id="auditSection" class="mt-4 pt-4 border-top d-none">
                    <div class="section-title">Historial de Auditoría</div>
                    <div id="auditTimeline"></div>
                </div>

                <div class="mt-4 pt-4 border-top d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" onclick="closeModal('modalFieldMaster')">Cerrar</button>
                    <button type="button" id="btnSaveField" class="btn-main px-4 shadow-sm" onclick="handleSaveMasterField()">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // MOCK DATA
        let mockMasterFields = [
            { id: 1, label: 'Fecha de Expedición', tech: 'fec_expedicion', type: 'DATE', status: 'ACTI', required: true, order: 10, placeholder: 'dd/mm/aaaa', maxLength: 10, history: [
                { action: 'CREATE', user: 'cgonzalez', date: '10/01/2026 08:30', desc: 'Registro inicial.' }
            ]},
            { id: 2, label: 'Tipo de Documento', tech: 'id_tipo_doc', type: 'FIXED_LIST', status: 'ACTI', required: true, order: 20, possibleValues: 'Cédula, Pasaporte', images_by_value: { 'Pasaporte': '/img/passport.png' }, history: [] },
            { id: 3, label: 'Departamento de Residencia', tech: 'id_departamento', type: 'SELECT', status: 'ACTI', required: true, order: 30, desc: 'SELECT id_dep, nom_dep FROM par_departamentos ORDER BY nom_dep', history: [] }
        ];

        function toggleSidebar() {
            document.getElementById('mainSidebar').classList.toggle('show');
            document.getElementById('sidebarOverlay').classList.toggle('active');
        }

        function toggleUserMenu(e) { e.stopPropagation(); document.getElementById('userMenu').classList.toggle('show'); }
        function toggleA11yMenu(e) { e.stopPropagation(); document.getElementById('a11yMenu').classList.toggle('show'); }
        
        document.addEventListener('click', () => {
            if (document.getElementById('userMenu')) document.getElementById('userMenu').classList.remove('show');
            if (document.getElementById('a11yMenu')) document.getElementById('a11yMenu').classList.remove('show');
            if (document.getElementById('sidebarGlobalPopup')) document.getElementById('sidebarGlobalPopup').classList.remove('show');
        });

        // GRID LOGIC
        function renderMasterFields() {
            const body = document.getElementById('masterFieldsTableBody');
            body.innerHTML = mockMasterFields.map(f => `
                <tr>
                    <td class="text-center"><input type="checkbox" class="record-check" onchange="updateSelectionUI()" title="Seleccionar ID ${f.id}"></td>
                    <td class="text-center fw-bold text-navy">${f.id}</td>
                    <td><div class="fw-bold text-navy">${f.label}</div></td>
                    <td><code>${f.tech}</code></td>
                    <td><span class="badge bg-light text-dark border px-2">${f.type === 'FIXED_LIST' ? 'Lista fija' : f.type}</span></td>
                    <td class="text-center">
                        <div class="d-flex justify-content-center gap-2">
                            <button class="btn btn-sm btn-light border" onclick="openFieldModal('view', ${f.id})" title="Ver detalles e historial"><i data-lucide="eye" style="width:14px"></i></button>
                            <button class="btn btn-sm btn-light border" onclick="openFieldModal('edit', ${f.id})" title="Modificar configuración"><i data-lucide="edit-3" style="width:14px"></i></button>
                        </div>
                    </td>
                </tr>
            `).join('');
            lucide.createIcons();
        }

        function updateSelectionUI() {
            document.getElementById('btnInactivateFields').disabled = document.querySelectorAll('.record-check:checked').length === 0;
        }

        function toggleSelectAllItems() {
            const check = document.getElementById('selectAllFields').checked;
            document.querySelectorAll('.record-check').forEach(c => c.checked = check);
            updateSelectionUI();
        }

        function handleCancelSelection() {
            document.querySelectorAll('.record-check').forEach(c => c.checked = false);
            document.getElementById('selectAllFields').checked = false;
            updateSelectionUI();
        }

        function handleMasterFieldSearch() { renderMasterFields(); }

        // FORM LOGIC
        function toggleOptionsField() {
            const type = document.getElementById('fieldType').value;
            document.getElementById('containerPossibleValues').classList.toggle('d-none', type !== 'FIXED_LIST');
            document.getElementById('containerSQL').classList.toggle('d-none', type !== 'SELECT');
            if(type === 'FIXED_LIST') toggleValueImagesSection();
        }

        function toggleValueImagesSection() {
            const check = document.getElementById('checkUseValueImages');
            const container = document.getElementById('containerValuesImages');
            if (check.checked) {
                container.classList.remove('d-none');
                renderValueImageInputs();
            } else {
                container.classList.add('d-none');
            }
        }

        function renderValueImageInputs() {
            const input = document.getElementById('fieldPossibleValues');
            const list = document.getElementById('valueImagesList');
            const vals = input.value.split(',').map(v => v.trim()).filter(v => v.length > 0);
            
            // Si está checkeado pero no hay valores escritos
            if (vals.length === 0) {
                list.innerHTML = `
                    <div class="warning-images">
                        <i data-lucide="alert-circle" style="width:20px"></i>
                        Debe agregar valores posibles para asociar la imagen
                    </div>
                `;
                lucide.createIcons();
                return;
            }

            // Si hay valores, renderizar la lista
            list.innerHTML = `
                <div class="values-images-card">
                    <div class="fw-bold text-primary small uppercase mb-3"><i data-lucide="image" class="me-1" style="width:14px"></i> Imágenes por valor</div>
                    ${vals.map(v => `
                        <div class="value-image-row animate-fade" title="Defina la ruta para '${v}'">
                            <span class="value-name-label">${v}:</span>
                            <input type="text" class="form-control-mre" placeholder="Ruta de imagen...">
                        </div>
                    `).join('')}
                </div>
            `;
            lucide.createIcons();
        }

        function openFieldModal(mode, id) {
            const f = document.getElementById('formMasterField');
            const inputs = f.querySelectorAll('input, select, textarea');
            f.reset();
            document.getElementById('auditSection').classList.add('d-none');
            inputs.forEach(i => i.disabled = false);
            document.getElementById('btnSaveField').classList.remove('d-none');

            if (mode !== 'add') {
                const data = mockMasterFields.find(x => x.id === id);
                document.getElementById('fieldLabel').value = data.label || '';
                document.getElementById('fieldName').value = data.tech || '';
                document.getElementById('fieldType').value = data.type || '';
                document.getElementById('fieldBaseOrder').value = data.order || 1;
                document.getElementById('fieldMaxLength').value = data.maxLength || '';
                document.getElementById('fieldRequiredBase').checked = data.required || false;
                document.getElementById('fieldPossibleValues').value = data.possibleValues || '';
                
                toggleOptionsField();

                if (mode === 'view') {
                    inputs.forEach(i => i.disabled = true);
                    document.getElementById('btnSaveField').classList.add('d-none');
                    document.getElementById('auditSection').classList.remove('d-none');
                    const timeline = document.getElementById('auditTimeline');
                    timeline.innerHTML = `<table class="audit-grid-table">
                        <thead><tr><th>Fecha</th><th>Acción</th><th>Usuario</th><th>Descripción</th></tr></thead>
                        <tbody>${(data.history || []).map(h => `<tr><td>${h.date}</td><td><span class="badge-audit tag-create">${h.action}</span></td><td>${h.user}</td><td>${h.desc}</td></tr>`).join('')}</tbody>
                    </table>`;
                }
            }
            document.getElementById('modalFieldMaster').style.display = 'flex';
            lucide.createIcons();
        }

        function closeModal(id) { document.getElementById(id).style.display = 'none'; }
        function handleSaveMasterField() { alert('Guardado con éxito.'); closeModal('modalFieldMaster'); }

        // Sidebar Popups (Tooltips informativos)
        let popupTimer;
        const globalPopup = document.getElementById('sidebarGlobalPopup');
        document.querySelectorAll('.nav-link-mre[data-popup]').forEach(link => {
            link.addEventListener('mouseenter', () => {
                clearTimeout(popupTimer);
                const r = link.getBoundingClientRect();
                globalPopup.innerHTML = link.dataset.popup;
                globalPopup.style.top = `${r.top + (r.height / 2)}px`;
                globalPopup.style.left = `${r.right + 10}px`;
                globalPopup.style.transform = 'translateY(-50%)';
                globalPopup.classList.add('show');
            });
            link.addEventListener('mouseleave', () => {
                popupTimer = setTimeout(() => { if (!globalPopup.matches(':hover')) globalPopup.classList.remove('show'); }, 150);
            });
        });

        // Accesibilidad
        function changeFontSize(delta) {
            let current = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--font-scale')) || 1;
            let newScale = Math.min(Math.max(current + delta, 0.8), 1.5); 
            document.documentElement.style.setProperty('--font-scale', newScale);
            document.getElementById('fontSizeDisplay').innerText = Math.round(newScale * 100) + '%';
        }
        function toggleGrayscale() { document.body.classList.toggle('grayscale-mode'); }
        function handleLogout() { location.reload(); }

        document.addEventListener('DOMContentLoaded', () => { 
            renderMasterFields(); 
            lucide.createIcons(); 
        });
    </script>
</body>
</html>
