        function handleDetailClick(id) {
            // VERIFICACIÓN DE SEGURIDAD: Impedir tomar más de una solicitud
            const myLocked = requests.find(r => r.lockedBy === 'Me');
            if (myLocked && myLocked.id !== id) {
                alert(`Usted ya está procesando la solicitud #${myLocked.id}. Debe finalizarla o liberarla antes de tomar otra.`);
                return;
            }

            const req = requests.find(r => r.id === id);
            actionTargetId = id;
            document.getElementById('detailModalContent').innerHTML = getRequestSummaryHTML(req);
            
            const footer = document.getElementById('detailModalFooter');
            if (req.lockedBy === 'Me') {
                footer.innerHTML = `
                    <button class="btn btn-light border fw-bold" onclick="closePopup()">Cancelar</button>
                    <button class="btn btn-outline-secondary fw-bold" onclick="unlockRequest('${req.id}'); closePopup()">Liberar</button>
                    <button class="btn-main px-4" onclick="takeRequestFromModal()">Continuar</button>
                `;
            } else {
                footer.innerHTML = `
                    <button class="btn btn-light border fw-bold" onclick="closePopup()">Cancelar</button>
                    <button class="btn-main px-4" onclick="takeRequestFromModal()">Tomar Solicitud</button>
                `;
            }

            document.getElementById('detailModal').style.display = 'flex';
        }

        function takeRequestFromModal() {
            const req = requests.find(r => r.id === actionTargetId);
            if (req.lockedBy !== 'Me') req.lockedBy = 'Me';
            document.getElementById('detailModal').style.display = 'none';
            openVerification(req.id);
        }

        function openVerification(id) {
            const req = requests.find(r => r.id === id);
            
            // Header Info
            document.getElementById('verifyReqId').innerText = `Solicitud #${req.id}`;
            document.getElementById('verifyReqName').innerText = `${req.name} (CI: ${req.ci})`;

            // Populate Data Container
            const container = document.getElementById('verifyDataContainer');
            
            const type = req.type || 'Apostilla';
            const inst = req.institution || 'N/A';
            const phys = req.physicalNumber || 'N/A';
            const sig = req.signatureType || req.signature || 'N/A'; // Manejo de ambas propiedades
            
            let officialHtml = '';
            if (req.official) {
                officialHtml = `
                <div class="col-12 bg-light p-2 rounded border mt-2">
                    <label class="small text-muted fw-bold text-uppercase d-block">Funcionario Firmante Detectado</label>
                    <strong class="text-dark text-uppercase">${req.official}</strong>
                </div>`;
            }

            container.innerHTML = `
                <div class="col-6">
                    <label class="small text-muted fw-bold text-uppercase d-block">País Destino</label>
                    <strong class="text-dark">${req.country}</strong>
                </div>
                <div class="col-6">
                    <label class="small text-muted fw-bold text-uppercase d-block">Trámite</label>
                    <strong class="text-dark">${type}</strong>
                </div>
                <div class="col-12">
                    <label class="small text-muted fw-bold text-uppercase d-block">Institución Emisora</label>
                    <strong class="text-dark">${inst}</strong>
                </div>
                <div class="col-12">
                    <label class="small text-muted fw-bold text-uppercase d-block">Tipo Documento</label>
                    <strong class="text-primary fs-5">${req.doc}</strong>
                </div>
                <div class="col-6">
                    <label class="small text-muted fw-bold text-uppercase d-block">Nro. Físico / Certificado</label>
                    <strong class="text-dark">${phys}</strong>
                </div>
                <div class="col-6">
                    <label class="small text-muted fw-bold text-uppercase d-block">Firma</label>
                    <span class="badge ${sig.includes('Electrónica') ? 'bg-primary-subtle text-primary border border-primary-subtle' : 'bg-light text-dark border'}">${sig}</span>
                </div>
                ${officialHtml}
            `;

            const splitContainer = document.querySelector('.split-screen-container');
            const viewerContainer = document.querySelector('.split-side-a');
            const physicalBanner = document.getElementById('physicalVerificationBanner');

            // Reset classes
            splitContainer.classList.remove('single-mode');
            viewerContainer.classList.remove('hidden');
            physicalBanner.classList.add('hidden');

            // Usar la variable local 'sig' que normaliza la propiedad signature/signatureType
            if (sig.includes('Ológrafa')) {
                splitContainer.classList.add('single-mode');
                physicalBanner.classList.remove('hidden');
            } else {
                viewerContainer.innerHTML = `
                    <div class="pdf-viewer-placeholder">
                        <i data-lucide="file-text" style="width: 64px; height: 64px; opacity: 0.5;"></i>
                        <p class="mt-3 fw-bold">Visualizador de Documento</p>
                        <small class="text-white-50">Aquí se cargará el PDF digital o escaneado</small>
                        <button class="btn btn-sm btn-outline-light mt-3" onclick="alert('Simulando zoom...')"><i data-lucide="maximize"></i> Ampliar</button>
                    </div>
                `;
            }

            document.getElementById('dashboardView').classList.add('hidden');
            document.getElementById('verificationView').classList.remove('hidden');
            lucide.createIcons();
        }

        function backToDashboard() {
            document.getElementById('verificationView').classList.add('hidden');
            document.getElementById('liquidationView').classList.add('hidden');
            document.getElementById('newRequestView').classList.add('hidden');
            document.getElementById('dashboardView').classList.remove('hidden');
            filterTable(currentStatus);
        }

        function processApprove() {
            const req = requests.find(r => r.id === actionTargetId || r.lockedBy === 'Me');
            req.status = 'Aprobado';
            req.lockedBy = null;
            closePopup();
            backToDashboard();
        }

        function processReturn() {
            const obs = document.getElementById('returnObs').value;
            if(!obs) return alert("Ingrese el motivo.");
            const req = requests.find(r => r.id === actionTargetId || r.lockedBy === 'Me');
            req.status = 'Devuelto';
            req.lockedBy = null;
            closePopup();
            backToDashboard();
        }

        function processReject() {
            const obs = document.getElementById('rejectObs').value;
            if(!obs) return alert("Ingrese el motivo.");
            const req = requests.find(r => r.id === actionTargetId || r.lockedBy === 'Me');
            req.status = 'Rechazado';
            req.lockedBy = null;
            closePopup();
            backToDashboard();
        }

        function unlockRequest(id) {
            const req = requests.find(r => r.id === id);
            req.lockedBy = null;
            filterTable(currentStatus);
        }

        function unlockRequestFromVerification() { unlockRequest(actionTargetId); backToDashboard(); }

        function openPaymentModal() { 
            const count = document.querySelectorAll('.pay-check:checked').length;
            document.getElementById('payQty').innerText = count;
            document.getElementById('payTotalGs').innerText = `Gs. ${(count * 80100).toLocaleString('es-PY')}`;
            document.getElementById('paymentModal').style.display = 'flex'; 
        }

        function confirmPayment() {
            closePopup();
            document.getElementById('dashboardView').classList.add('hidden');
            document.getElementById('liquidationView').classList.remove('hidden');
            lucide.createIcons();
        }

        function closePopup() { document.querySelectorAll('.mre-popup-overlay').forEach(p => p.style.display = 'none'); }
        
        function openReturnModal(id = null) { 
            if(id) actionTargetId = id;
            const req = requests.find(r => r.id === actionTargetId || r.lockedBy === 'Me');
            document.getElementById('returnModalContent').innerHTML = getRequestSummaryHTML(req);
            document.getElementById('returnModal').style.display = 'flex'; 
        }

        function openRejectModal(id = null) { 
            if(id) actionTargetId = id;
            const req = requests.find(r => r.id === actionTargetId || r.lockedBy === 'Me');
            document.getElementById('rejectModalContent').innerHTML = getRequestSummaryHTML(req);
            document.getElementById('rejectModal').style.display = 'flex'; 
        }

        function openApproveModal(id = null) { 
            if(id) actionTargetId = id;
            const req = requests.find(r => r.id === actionTargetId || r.lockedBy === 'Me');
            document.getElementById('approveModalContent').innerHTML = getRequestSummaryHTML(req);
            document.getElementById('approveModal').style.display = 'flex'; 
        }

        function handleDetailModalClose() { document.getElementById('detailModal').style.display = 'none'; }
        function toggleSelectAll(cb) { document.querySelectorAll('.pay-check').forEach(p => p.checked = cb.checked); }
        
        function filterOptions(input) {
            const filter = input.value.toUpperCase();
            const items = input.nextElementSibling.getElementsByClassName('dropdown-item');
            for (let i = 0; i < items.length; i++) {
                items[i].style.display = items[i].innerText.toUpperCase().includes(filter) ? "" : "none";
            }
        }

        function filterByCI(input) {
            const val = input.value.toLowerCase().replace(/\./g, '');
            if (!val) { filterTable(currentStatus); return; }
            const rows = document.querySelectorAll('#tableBody tr');
            rows.forEach(r => r.style.display = r.innerText.toLowerCase().includes(val) ? '' : 'none');
        }
    </script>
</body>
</html>
