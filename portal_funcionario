        // --- LÓGICA DE CORRECCIÓN ---
        function completeRequest(id) {
            const req = requests.find(r => r.id === id);
            if (!req) return;

            document.getElementById('dashboardView').classList.add('hidden');
            document.getElementById('newRequestView').classList.remove('hidden');
            document.getElementById('requestFormContainer').classList.remove('hidden');
            document.getElementById('loadedDocsSection').classList.add('hidden');

            // Set Editing Mode
            isEditing = true;
            editingId = id;
            document.getElementById('formTitle').innerText = `Corregir Solicitud #${id}`;
            document.getElementById('formBadge').innerText = "Modificación";
            document.getElementById('btnSubmitForm').innerHTML = `<i data-lucide="save" style="width:16px;"></i> Guardar Cambios`;

            // Populate Form (Simplified)
            setOption('reqCountry', req.country, document.getElementById('div_reqCountry'));
            setOption('reqSignature', req.signature, document.getElementById('div_reqSignature'));
            document.getElementById('titularName').value = req.name;
            document.getElementById('titularCertNum').value = "123456"; // Dummy
            // document.getElementById('titularCI').value = req.ci; // ELIMINADO: Ya no existe el campo en el DOM

            handleSignatureChange();
        }

        function submitFormAction() {
            if (isEditing) {
                // Logic for editing
                const req = requests.find(r => r.id === editingId);
                if(req) {
                    req.status = 'Análisis'; // Return to Analysis
                    alert(`Solicitud #${editingId} corregida y enviada a Análisis.`);
                    backToDashboard();
                }
            } else {
                initiateAddProcess();
            }
        }

        function initiateAddProcess() {
            const signature = document.getElementById('reqSignature').value;
            if (signature.includes('Electrónica')) {
                startValidationProcess();
            } else {
                addToGrid('Previa', null);
            }
        }

        function startValidationProcess() {
            const popupTitle = document.getElementById('popupTitle');
            const popupContent = document.getElementById('popupContent');
            const popupActions = document.getElementById('popupActions');

            popupTitle.innerText = "Validando Documento...";
            popupContent.innerHTML = `
                <div class="text-center p-4">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <p class="text-muted small fw-bold">Conectando con servicio de firma electrónica o verificable...</p>
                </div>
            `;
            popupActions.innerHTML = '';
            document.getElementById('genericPopup').style.display = 'flex';

            setTimeout(() => {
                showValidationResult();
            }, 1500); 
        }

        function showValidationResult() {
            electronicSigCount++;
            let scenario = ''; 
            const demoIndex = (electronicSigCount % 3);
            if (demoIndex === 1) scenario = 'SUCCESS';
            else if (demoIndex === 2) scenario = 'CONN_ERROR';
            else scenario = 'INVALID'; 

            const popupTitle = document.getElementById('popupTitle');
            const popupContent = document.getElementById('popupContent');
            const popupActions = document.getElementById('popupActions');

            let icon = '', title = '', message = '';

            if (scenario === 'SUCCESS') {
                icon = '<div class="bg-success-subtle text-success p-3 rounded-circle d-inline-flex mb-3"><i data-lucide="check-circle-2" style="width:40px; height:40px"></i></div>';
                title = 'Validación Exitosa';
                message = '<p class="fw-bold text-success">El documento ha sido validado correctamente.</p>';
            } else if (scenario === 'CONN_ERROR') {
                icon = '<div class="bg-warning-subtle text-warning-emphasis p-3 rounded-circle d-inline-flex mb-3"><i data-lucide="wifi-off" style="width:40px; height:40px"></i></div>';
                title = 'Error de Conexión';
                message = '<p class="fw-bold text-warning-emphasis">No se pudo conectar con el servicio de validación.</p>';
            } else if (scenario === 'INVALID') {
                icon = '<div class="bg-danger-subtle text-danger p-3 rounded-circle d-inline-flex mb-3"><i data-lucide="x-circle" style="width:40px; height:40px"></i></div>';
                title = 'Documento No Válido';
                message = '<p class="fw-bold text-danger">No se pudo validar el documento.</p>';
            }

            popupTitle.innerText = title;
            popupContent.innerHTML = `<div class="text-center p-2">${icon}${message}</div>`;
            popupActions.innerHTML = `
                <div class="d-flex gap-2 w-100">
                    <button class="btn btn-light w-50 border fw-bold" onclick="closePopup()">Volver</button>
                    <button class="btn-main w-100" onclick="handleValidationDecision('${scenario}')">Aceptar</button>
                </div>
            `;
            lucide.createIcons();
        }

        function handleValidationDecision(scenario) {
            closePopup();
            if (scenario === 'SUCCESS') addToGrid('Automática', true);
            else addToGrid('Previa', false); 
        }

        function setOption(inputId, value, element) {
            document.getElementById(inputId).value = value;
            const display = element.closest('.custom-select').querySelector('.selected-value');
            display.innerText = value;
            display.classList.remove('text-muted');
        }

        function filterOptions(input) {
            const filter = input.value.toUpperCase();
            const items = input.nextElementSibling.getElementsByClassName('dropdown-item');
            for (let i = 0; i < items.length; i++) {
                items[i].style.display = items[i].innerText.toUpperCase().includes(filter) ? "" : "none";
            }
        }

        function handleSignatureChange() {
            const sig = document.getElementById('reqSignature').value;
            const attach = document.getElementById('attachmentField');
            const official = document.getElementById('officialField');
            const btnDoc = document.getElementById('btn_reqDocType');
            
            attach.classList.add('hidden');
            official.classList.add('hidden');
            document.getElementById('reqFile').required = false;
            document.getElementById('reqOfficial').required = false;

            if (sig.includes('Electrónica')) {
                attach.classList.remove('hidden');
                document.getElementById('reqFile').required = true;
            } else if (sig.includes('Ológrafa')) {
                official.classList.remove('hidden');
            }

            btnDoc.disabled = !sig;
        }

        function handleDocTypeChange() {
            const doc = document.getElementById('reqDocType').value;
            const tabs = document.getElementById('additionalDataTabs');
            if(doc) tabs.classList.remove('hidden');
            else tabs.classList.add('hidden');
        }

        function addToBatchGrid() {
            // Lógica interna llamada por initiateAddProcess -> addToGrid
        }

        function addToGrid(valType, isValid) {
            const name = document.getElementById('titularName').value;
            const cert = document.getElementById('titularCertNum').value;
            // const ci = document.getElementById('titularCI').value; // ELIMINADO: Captura de CI removida
            const doc = document.getElementById('reqDocType').value;
            const sig = document.getElementById('reqSignature').value;
            const inst = document.getElementById('reqInstitution').value;
            const type = document.getElementById('reqType').value; 
            const country = document.getElementById('reqCountry').value; 
            const official = document.getElementById('reqOfficial').value; 

            if(!name || !cert) return;

            tempRequestsList.push({
                titularName: name, 
                titularDocNum: cert, 
                titularCI: '', // Se deja vacío ya que no se carga manualmente
                docType: doc, 
                signature: sig, 
                institution: inst, 
                type: type,
                country: country,
                official: official,
                validationType: valType, 
                isValidated: isValid, 
                hasFile: sig.includes('Electrónica'), 
                amount: 80100
            });

            renderLoadedDocuments();
            document.getElementById('requestFormContainer').classList.add('hidden');
            document.getElementById('loadedDocsSection').classList.remove('hidden');
        }

        function renderLoadedDocuments() {
            const tbody = document.getElementById('loadedDocsBody');
            tbody.innerHTML = tempRequestsList.map((item, i) => `
                <tr>
                    <td><span class="badge bg-light text-dark border">${item.signature}</span></td>
                    <td class="small">${item.institution}</td>
                    <td class="fw-bold text-navy">${item.docType}</td>
                    <td>${item.validationType === 'Automática' ? '<span class="badge bg-primary-subtle text-primary border border-primary-subtle">Automática</span>' : '<span class="badge bg-warning-subtle text-dark border border-warning-subtle">Validación Previa</span>'}</td>
                    <td class="text-center">${item.isValidated === true ? '<span class="badge bg-success">SÍ</span>' : (item.isValidated === false ? '<span class="badge bg-danger">NO</span>' : '-')}</td>
                    <td class="text-end fw-bold">Gs. ${item.amount.toLocaleString('es-PY')}</td> <!-- CORREGIDO: item.importe a item.amount -->
                    <td class="text-center">${item.hasFile ? '<i data-lucide="file-check" class="text-success"></i>' : '-'}</td>
                    <td class="text-center"><button class="btn btn-sm text-danger" onclick="removeFromGrid(${i})"><i data-lucide="trash-2"></i></button></td>
                </tr>
            `).join('');
            lucide.createIcons();
        }

        function removeFromGrid(index) { 
            tempRequestsList.splice(index, 1); 
            renderLoadedDocuments(); 
            if(tempRequestsList.length === 0) {
                document.getElementById('loadedDocsSection').classList.add('hidden');
                document.getElementById('requestFormContainer').classList.remove('hidden');
            }
        }

