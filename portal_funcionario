            tempRequestsList.forEach(item => {
                requests.push({ 
                    id: `2026-${Math.floor(Math.random()*90000)}`, 
                    date: '28/01/2026 20:30', 
                    ...item, 
                    name: item.titularName, 
                    ci: item.titularCI || 'N/A', 
                    doc: item.docType, 
                    physicalNumber: item.titularDocNum, // MAPEO CORRECTO
