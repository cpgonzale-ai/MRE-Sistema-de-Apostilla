                    <th>Nro. Solicitud</th>
                    <th>Fecha</th>
                    <th>Titular</th>
                    <th>Nro. de Certificado</th>
                    <th>Documento</th>
                    <th>Tipo Firma</th>
                    <th>País</th>
                    ${importeCol}
                    <th class="text-center">Acción</th>
                `;
            }

            const tbody = document.getElementById('tableBody');
            tbody.innerHTML = '';

            let filtered = requests.filter(r => r.status === status);
            if (currentProfile === 'olografo') filtered = filtered.filter(r => r.signature === 'Ológrafa');
            else if (currentProfile === 'electronico') filtered = filtered.filter(r => r.signature === 'Electrónica');

            filtered.sort((a, b) => parseDateStr(a.date) - parseDateStr(b.date));
            
            let nextAvailableId = null;
            const myLockedRequest = requests.find(r => r.lockedBy === 'Me');

            if (currentProfile === 'electronico' && status === 'Análisis') {
                const next = filtered.find(r => !r.lockedBy || r.lockedBy === 'Me');
                if (next) nextAvailableId = next.id;
            }

            const batchActions = document.getElementById('batchActions');
            batchActions.style.setProperty('display', (status === 'Aprobado' ? 'flex' : 'none'), 'important');

            if (filtered.length === 0) {
                const colspan = status === 'Finalizados' ? 9 : (status === 'Aprobado' ? 10 : 9);
                tbody.innerHTML = `<tr><td colspan="${colspan}" class="text-center py-5 text-muted">No hay registros en esta bandeja.</td></tr>`;
                return;
            }

            filtered.forEach(req => {
                let row = '';
                if (status === 'Finalizados') {
                    // ACTUALIZADO: Se eliminaron las celdas de 'type' e 'institution'
                    row = `
                        <tr>
                            <td class="fw-black text-navy p-3">${req.id}</td>
                            <td class="text-center p-3"><button class="btn-ver-pago d-inline-flex align-items-center gap-2" onclick="alert('Descargando documento final...')"><i data-lucide="download" style="width:14px;"></i> ${req.type === 'Apostilla' ? 'Descargar Apostilla' : 'Descargar Legalización'}</button></td>
                            <td class="text-center p-3"><i data-lucide="file-down" style="width:18px; cursor:pointer; color:var(--mre-blue)" title="Descargar Comprobante de Pago" onclick="alert('Descargando comprobante...')"></i></td>
                            <td class="small text-muted p-3">${req.date}</td>
                            <td class="text-uppercase small fw-bold p-3">${req.name}</td>
                            <td class="fw-bold text-primary p-3">${req.physicalNumber || '-'}</td>
                            <td class="fw-bold text-navy p-3">${req.doc}</td>
                            <td class="p-3"><span class="badge bg-light text-dark border">${req.signature}</span></td>
                            <td class="text-center p-3"><button class="btn-ver-detalle" onclick="showRequestDetails('${req.id}')" title="Ver detalles completos">Ver Detalle</button></td>
                        </tr>
                    `;
                } else {
                    let checkCell = status === 'Aprobado' ? `<td class="text-center p-3"><input type="checkbox" class="form-check-input pay-check" value="${req.id}" checked></td>` : '';
                    let importeCell = status === 'Aprobado' ? `<td class="text-end fw-black text-primary p-3">Gs. ${(req.amount || 0).toLocaleString('es-PY')}</td>` : '';

                    let rowClass = '';
                    let isNext = false;
                    const isTakenByMe = req.lockedBy === 'Me';
                    
                    if (status === 'Análisis') {
                        if (req.lockedBy === 'OtroFuncionario') rowClass = 'row-locked-other';
                        else if (isTakenByMe) { isNext = true; rowClass = 'taken-by-me-highlight'; }
                        else if (currentProfile === 'electronico' && req.id === nextAvailableId) { rowClass = 'next-turn-highlight'; isNext = true; }
                    }

                    let actionBtn = '';
                    if (status === 'Análisis') {
                        const hasOtherLocked = myLockedRequest && myLockedRequest.id !== req.id;
                        const isDisabled = req.lockedBy === 'OtroFuncionario' || (currentProfile === 'electronico' && !isNext) || hasOtherLocked;
                        const titleText = hasOtherLocked ? "Ya tiene una solicitud en curso" : "Ver Detalle";
                        const actionDisabled = !isTakenByMe;
                        
                        actionBtn = `<div class="d-flex gap-1 justify-content-center">
                            <button class="btn btn-sm btn-primary" onclick="handleDetailClick('${req.id}')" ${isDisabled ? 'disabled' : ''} title="${titleText}"><i data-lucide="eye" style="width:14px"></i></button>
                            <button class="btn btn-sm btn-success" onclick="openApproveModal('${req.id}')" ${actionDisabled ? 'disabled' : ''} title="Aprobar"><i data-lucide="check" style="width:14px"></i></button>
                            <button class="btn btn-sm btn-warning text-white" onclick="openReturnModal('${req.id}')" ${actionDisabled ? 'disabled' : ''} title="Devolver"><i data-lucide="rotate-ccw" style="width:14px"></i></button>
                            <button class="btn btn-sm btn-danger" onclick="openRejectModal('${req.id}')" ${actionDisabled ? 'disabled' : ''} title="Rechazar"><i data-lucide="x" style="width:14px"></i></button>
                            ${isTakenByMe ? `<button class="btn btn-sm btn-outline-secondary" onclick="unlockRequest('${req.id}')" title="Desbloquear Solicitud"><i data-lucide="unlock" style="width:14px"></i></button>` : ''}
                        </div>`;
                    } else if (status === 'Aprobado') {
                         actionBtn = currentProfile === 'supervisor' ? `<button class="btn btn-sm btn-info text-white" onclick="exonerateRequest('${req.id}')">Exonerar</button>` : `<span class="badge bg-success">Listo para Pago</span>`;
                    } else if (status === 'Devuelto') {
                        if (req.origin === 'Funcionario') {
                             actionBtn = `<button class="btn btn-sm btn-warning text-dark fw-bold border-0 shadow-sm" onclick="completeRequest('${req.id}')"><i data-lucide="edit" style="width:14px; margin-right:4px"></i> Corregir</button>`;
                        } else {
                             actionBtn = `<span class="badge bg-warning text-dark">Pendiente Ciudadano</span>`;
                        }
                    } else if (status === 'Rechazado') {
                         actionBtn = `<span class="badge bg-danger">Rechazado</span>`;
                    }

                    row = `
                        <tr class="${rowClass}">
                            ${checkCell}
                            <td class="fw-black text-navy p-3">${req.id}</td>
                            <td class="small text-muted p-3">${req.date}</td>
                            <td class="text-uppercase fw-bold p-3">${req.name}</td>
                            <td class="fw-bold text-primary p-3">${req.physicalNumber || '-'}</td>
                            <td class="p-3 small">${req.doc}</td>
                            <td class="p-3"><span class="badge bg-light text-dark border">${req.signature}</span></td>
                            <td class="p-3">${req.country}</td>
                            ${importeCell}
                            <td class="text-center p-3">${actionBtn}</td>
                        </tr>
                    `;
                }
                tbody.insertAdjacentHTML('beforeend', row);
            });
            lucide.createIcons();
        }

